# 하나무늬(HANAMUNI) 환경변수 설정 예시
# 이 파일을 복사하여 .env.local 로 이름 변경 후 실제 키를 입력하세요.
# 키가 없으면 mock 모드로 자동 폴백됩니다 — 앱은 키 없이도 완전히 작동합니다.

# ─── AI 생성 ───────────────────────────────────────────────────
# OpenAI GPT Image 2.0 (gpt-image-2) — 전통문양·한복 이미지 생성 [주력]
#   한글 텍스트 렌더 정확·고증 조건화에 최적
OPENAI_API_KEY=

# Anthropic Claude — 사연→감성라벨 정규화 + 전통성 점수 + 민속대백과 RAG
ANTHROPIC_API_KEY=

# 나노바나나(Gemini 2.5 Flash Image) — 이미지 생성 폴백 (선택)
NANOBANANA_API_KEY=

# ─── 공공데이터 API ────────────────────────────────────────────
# 문화공공데이터광장 전통문양조회 API (culture.go.kr/share)
CULTURE_API_KEY=

# 한국민족문화대백과사전 API (encykorea.aks.ac.kr)
ENCYKOREA_API_KEY=

# ─── 배포 ───────────────────────────────────────────────────────
# Vercel 배포 시 자동으로 설정됨 (수동 입력 불필요)
# NEXT_PUBLIC_VERCEL_URL=
